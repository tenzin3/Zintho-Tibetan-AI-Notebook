# Paste your Monlam Studio API key after the = (no spaces, no quotes).
# Without a key, Zintho runs in demo mode (sample answers only).
MONLAM_API_KEY=

# --- Monlam Studio API (https://api-v1.monlamai.studio/docs) ------------
MONLAM_BASE_URL=https://api-v1.monlamai.studio/api/v1
MONLAM_AUTH_HEADER=X-API-Key
MONLAM_AUTH_PREFIX=

# Chat model: melong-2.5 (130k context) or melong-2.8
MONLAM_CHAT_MODEL=melong-2.5
MONLAM_CHAT_PATH=/ai/chat

# Text-to-speech. Voices: lhasa_female, lhasa_male, amdo_female, amdo_male, kham_female, kham_male
MONLAM_TTS_MODEL=monlamai-tts
MONLAM_TTS_PATH=/text-to-speech/stream
# Read-aloud voice, and host 1 of the audio overview
MONLAM_TTS_VOICE=lhasa_female
# Host 2 of the audio overview
MONLAM_TTS_VOICE_B=lhasa_male

# Speech-to-text
MONLAM_STT_MODEL=monlamai-stt
MONLAM_STT_PATH=/speech-to-text/
MONLAM_STT_LANGUAGE=bo

# OCR
MONLAM_OCR_MODEL=monlam-ocr
MONLAM_OCR_PATH=/ocr/single-page
MONLAM_OCR_LANG=bo

# --- App -----------------------------------------------------------------
PORT=4747
# Max characters of source text sent to the model per request
MAX_CONTEXT_CHARS=200000
